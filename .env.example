# DAS Ticketing System — env example (Railway Variables أو ملف .env محلي)

# باسورد الأدمن — إجباري في الإنتاج
ADMIN_PASS=ChangeThisStrongPassword123!

# VAPID keys للإشعارات (اختياري — من غيرهم الإشعارات بتتقفل بنفسها)
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# ============ ربط الروستر (الحضور) ============
# عنوان سيرفر البنكاي الروستر (بدون / في الآخر)
ROSTER_URL=https://your-roster.up.railway.app

# باسورد أدمن الروستر — للعرض الحضور وتحديث بيانات المناديب (شاشة الربط)
ROSTER_ADMIN_PASSWORD=

# مفتاح واجهات حضور/انصراف من DAS للروستر (سر سيرفري تاني).
# لازم نفس القيمة متحددة على سيرفر الروستر كـ DAS_SECRET.
# لو ناقص، زرار Check In / Check Out هيتوصف إن الخدمة مش متاحة.
ROSTER_DAS_SECRET=put-a-long-random-secret-here
